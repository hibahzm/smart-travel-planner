# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=travel
POSTGRES_PASSWORD=travelpass
POSTGRES_DB=traveldb
DATABASE_URL=postgresql+asyncpg://travel:travelpass@db:5432/traveldb

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# Models (cheap for mechanics, strong for synthesis)
PLANNER_MODEL=gpt-4o-mini
SYNTHESIZER_MODEL=gpt-4o

# ── Weather (https://openweathermap.org/api — free tier) ─────────────────────
OPENWEATHERMAP_API_KEY=your_owm_key_here

# ── Flights ───────────────────────────────────────────────────────────────────
# No external flight API needed — cost estimates use great-circle distance.
# (Amadeus self-service was shut down in 2026; Frankfurter handles FX for free.)

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_long_random_string_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Webhook (Discord) — right-click channel → Integrations → Webhooks ─────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=3

# ── LangSmith tracing (https://smith.langchain.com — free tier) ──────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=smart-travel-planner

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
